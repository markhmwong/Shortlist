default_platform(:ios)

APP_IDS = [
  "com.whizbang.shortlist",
  "com.whizbang.shortlist.widget",
].freeze

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    enable_automatic_code_signing
    increment_build_number
    build_app(
      workspace: "Shortlist.xcworkspace",
      scheme: "Shortlist",
      export_xcargs: "-allowProvisioningUpdates",
    )
    upload_to_testflight
  end

  desc "Sync certificates and provisioning profiles"
  lane :certs do
    update_project_team(
      path: "Shortlist.xcodeproj",
      teamid: "GEKZN86RYS"
    )
    match(type: "appstore",    app_identifier: APP_IDS)
    match(type: "development", app_identifier: APP_IDS)
    match(type: "adhoc",       app_identifier: APP_IDS)
  end

  desc "App Store Release — v3.0.0"
  lane :release do
    APP_IDS.each { |id| get_provisioning_profile(app_identifier: id) }

    increment_build_number
    increment_version_number(version_number: "3.0.0")

    build_app(
      workspace: "Shortlist.xcworkspace",
      scheme: "Shortlist",
      output_directory: "./fastlane/builds",
      export_xcargs: "-allowProvisioningUpdates",
    )
    upload_to_app_store
  end

  desc "Screenshots only (no upload)"
  lane :screenshots do
    capture_ios_screenshots
  end
end
